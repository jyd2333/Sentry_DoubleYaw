{
  "version": 4,
  "configurations": [
    {
      "name": "Win32",
      "compilerPath": "${env:USERPROFILE}/.eide/tools/gcc_arm/bin/arm-none-eabi-gcc.exe",
      "intelliSenseMode": "gcc-arm",
      "cStandard": "gnu11",
      "cppStandard": "c++11",
      "defines": [
        "USE_HAL_DRIVER",
        "STM32F407xx",
        "ARM_MATH_CM4",
        "DEBUG"
      ],
      "includePath": [
        "${workspaceFolder}/**",
        "${env:USERPROFILE}/.eide/tools/gcc_arm/arm-none-eabi/include",
        "${env:USERPROFILE}/.eide/tools/gcc_arm/lib/gcc/arm-none-eabi/10.2.1/include",
        "${env:USERPROFILE}/.eide/tools/gcc_arm/lib/gcc/arm-none-eabi/10.2.1/include-fixed"
      ]
    }
  ]
}